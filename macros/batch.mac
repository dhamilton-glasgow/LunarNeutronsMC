/LunarNeutronsMC/physics/addPhysics QGSP_BIC_HP
/run/initialize
/LunarNeutronsMC/analysis/setOutputFile moon_protons_2000.txt
/gps/particle proton
/gps/ang/type cos
/gps/ang/mintheta 0.00 deg
/gps/ang/maxtheta 90.00 deg
/gps/pos/type Point
/gps/pos/centre 0. 0. 10.1 m
/gps/energy 1000 MeV

/run/beamOn 2000
